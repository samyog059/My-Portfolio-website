# Copy this to .env and fill real values
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTERNAME.mongodb.net/DBNAME?retryWrites=true&w=majority&appName=APPNAME
PORT=5000
# Comma-separated list of allowed origins for CORS (no spaces needed)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://your-frontend-domain.com
